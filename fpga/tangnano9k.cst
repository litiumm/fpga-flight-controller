// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) pin constraints for hil_top

IO_LOC  "clk" 52;
IO_PORT "clk" PULL_MODE=UP;

IO_LOC  "rst_n" 4;          // S2 button, active low
IO_PORT "rst_n" PULL_MODE=UP;

IO_LOC  "uart_tx" 17;       // to on-board BL702 USB-UART
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" PULL_MODE=UP;

IO_LOC  "pwm1" 25;          // ESC outputs on the pin header
IO_LOC  "pwm2" 26;

IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8;
